{
  "entities": {
    "LabScenarioDoc": {
      "title": "LabScenarioDoc",
      "description": "A saved digital twin laboratory floor plan scenario with zone, equipment, wall, and opening layouts.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "description": "Unique scenario ID"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "Firebase Auth UID of the scenario author"
        },
        "authorEmail": {
          "type": "string",
          "maxLength": 256,
          "description": "Email address of the author"
        },
        "name": {
          "type": "string",
          "maxLength": 100,
          "description": "Display name of the laboratory scenario"
        },
        "subtitle": {
          "type": "string",
          "maxLength": 250,
          "description": "Short explanation or notes on this scenario variation"
        },
        "isBuiltIn": {
          "type": "boolean",
          "description": "Whether this is a standard template preset"
        },
        "labWidth": {
          "type": "number",
          "description": "Interior room width in meters"
        },
        "labDepth": {
          "type": "number",
          "description": "Interior room depth in meters"
        },
        "zones": {
          "type": "array",
          "description": "Array of lab zones"
        },
        "equipment": {
          "type": "array",
          "description": "Array of lab equipment"
        },
        "walls": {
          "type": "array",
          "description": "Array of room walls"
        },
        "openings": {
          "type": "array",
          "description": "Array of doors and windows"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last updated timestamp"
        }
      },
      "required": ["id", "userId", "name", "updatedAt"]
    }
  },
  "firestore": {
    "/scenarios/{scenarioId}": {
      "schema": "LabScenarioDoc",
      "description": "User saved and shared laboratory scenarios"
    }
  }
}
